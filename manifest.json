{
  "manifest_version": 3,
  "name": "PredictFlow",
  "version": "0.1.0",
  "description": "Kalshi market research, category search, followed events, and local practice simulations.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open PredictFlow"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
