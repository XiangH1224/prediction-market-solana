# Required.
XAI_API_KEY=

# Optional. Without it, news comes from GDELT (free, keyless, headlines only).
TAVILY_API_KEY=

# Optional for scanning, required for trading. Without it, markets and prices come
# from Kalshi's public API and nothing can be staged (signals only).
DFLOW_API_KEY=

# Grok model id; check xAI's current model list.
XAI_MODEL=grok-4
# Any OpenAI-compatible provider works, e.g. Groq: https://api.groq.com/openai/v1
# XAI_BASE_URL=https://api.x.ai/v1

# Each market is forecast ENSEMBLE_SIZE times; disagreement between runs lowers confidence.
# To run one forecast per model instead (helps when limits are per model):
# XAI_ENSEMBLE_MODELS=model-a,model-b,model-c
ENSEMBLE_SIZE=3
# Tried in order when XAI_MODEL is rate-limited, e.g. a free tier's daily cap.
# XAI_FALLBACK_MODELS=model-b,model-c
# Seconds before a market is searched and forecast again.
PREDICTION_TTL_S=3600

# Mainnet RPC used for balances and dry runs. The public endpoint is heavily rate-limited.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: restrict the scan, e.g. SERIES_TICKERS=KXEPLGAME,KXFED
SERIES_TICKERS=
MAX_MARKETS=25
# Market selection: YES price band, days until close (0 = no limit), markets per event.
MIN_PRICE=0.05
MAX_PRICE=0.95
MAX_DAYS_TO_CLOSE=45
MAX_PER_EVENT=2

# Edge and sizing
EDGE_HURDLE=0.06
KELLY_FRACTION=0.25
MAX_POSITION_FRACTION=0.05
MAX_TRADE_USD=25
MIN_CONFIDENCE=0.5

# Optional: require this shared secret from the panel. Leave unset for local use.
# PANEL_TOKEN=

# Simulated trading
PAPER_BANKROLL_USD=1000
PAPER_DEFAULT_STAKE_USD=10
