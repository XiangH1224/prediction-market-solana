# Backend only. Copy to .env; never put credentials in extension files.
GNEWS_API_KEY=
FRED_API_KEY=
# Optional: BLS supports limited unregistered requests.
BLS_API_KEY=
# Required for SEC; optional contact in the NWS identifying User-Agent.
DATA_SOURCE_CONTACT_EMAIL=
# Optional: use 123 for the documented free development API; blank disables.
SPORTSDB_API_KEY=

# Optional paid X access. All gates + exact rules/author IDs are required.
X_STREAM_ENABLED=false
X_PAID_ACCESS_ENABLED=false
X_PLATFORM_SPEND_LIMIT_CONFIRMED=false
X_BEARER_TOKEN=
# Daily UTC budget; set conservative cost ceilings based on your X contract.
X_USAGE_BUDGET_USD=
X_MAX_POSTS_PER_DAY=
X_MAX_REQUESTS_PER_DAY=
X_POST_COST_CEILING_USD=
X_REQUEST_COST_CEILING_USD=
